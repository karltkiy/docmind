# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
# REQUIRED. There is no in-code fallback password; the app fails fast if this
# is unset. Replace with a strong, unique value outside of local development.
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=docmind
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Optional explicit override (takes precedence over the POSTGRES_* values)
# DATABASE_URL=postgresql+asyncpg://postgres:change-me-strong-password@localhost:5432/docmind

# ---------------------------------------------------------------------------
# Redis / Arq
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# RAG providers: "ollama" (local) or "openai" (cloud)
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=openai
LLM_PROVIDER=openai

# Model overrides (optional; sensible per-provider defaults are used)
# EMBEDDING_MODEL=text-embedding-3-small
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_DIM=1536

RETRIEVAL_TOP_K=4
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# REQUIRED when EMBEDDING_PROVIDER or LLM_PROVIDER is "openai"; the app fails
# fast at startup if it is missing.
OPENAI_API_KEY=your_openai_api_key_here

# Ollama endpoint (required when a provider is set to "ollama")
OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# Uploads / application
# ---------------------------------------------------------------------------
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=25

DEBUG=False
PORT=8000
LOG_LEVEL=INFO
# Emit single-line JSON logs (set to False for human-readable local output).
LOG_JSON=True
CORS_ORIGINS=*

# ---------------------------------------------------------------------------
# Streamlit demo UI
# ---------------------------------------------------------------------------
# Internal URL the demo container uses to reach the API (Compose service name;
# only resolvable inside the Docker network).
# DOCMIND_API_URL=http://api:8000/api/v1
# Browser-reachable API origin, used for the sidebar "API docs" link so it opens
# the Swagger UI instead of the non-routable /api/v1 prefix.
# DOCMIND_PUBLIC_API_URL=http://localhost:8000
