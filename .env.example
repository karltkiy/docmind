# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=docmind
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Optional explicit override (takes precedence over the POSTGRES_* values)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/docmind

# ---------------------------------------------------------------------------
# Redis / Arq
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# RAG providers: "ollama" (local) or "openai" (cloud)
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=openai
LLM_PROVIDER=openai

# Model overrides (optional; sensible per-provider defaults are used)
# EMBEDDING_MODEL=text-embedding-3-small
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_DIM=1536

RETRIEVAL_TOP_K=4
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# OpenAI credentials (required when a provider is set to "openai")
OPENAI_API_KEY=your_openai_api_key_here

# Ollama endpoint (required when a provider is set to "ollama")
OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# Uploads / application
# ---------------------------------------------------------------------------
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=25

DEBUG=True
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=*
