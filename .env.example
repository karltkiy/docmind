# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
# REQUIRED. There is no in-code fallback password; the app fails fast if this
# is unset. Replace with a strong, unique value outside of local development.
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=docmind
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Optional explicit override (takes precedence over the POSTGRES_* values)
# DATABASE_URL=postgresql+asyncpg://postgres:change-me-strong-password@localhost:5432/docmind
# Connection pool sizing per process (each API worker and the Arq worker owns a
# pool). Keep DB_POOL_SIZE + DB_MAX_OVERFLOW, times the worker count, below
# PostgreSQL's max_connections.
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10
# DB_POOL_RECYCLE_SECONDS=1800
# DB_POOL_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Redis / Arq
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Required by the production stack (docker-compose.prod.yml) to enable
# `requirepass`; the app builds the DSN with it automatically.
# REDIS_PASSWORD=change-me-redis-password
# Explicit DSN; overrides REDIS_*. Do NOT set this to a localhost URL in
# production — the Compose service host is `redis`.
# REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# RAG providers: "ollama" (local) or "openai" (cloud)
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=openai
LLM_PROVIDER=openai

# Model overrides (optional; sensible per-provider defaults are used)
# EMBEDDING_MODEL=text-embedding-3-small
# LLM_MODEL=gpt-6-luna
# Reasoning budget, openai provider only: none | low | medium | high | xhigh | max.
# The project default is "none" (reasoning tokens disabled: cheaper and faster,
# shallower answers). The provider's own default is "medium".
# LLM_REASONING_EFFORT=none
# REQUIRED by the production stack (docker-compose.prod.yml). It must match BOTH
# the configured embedding model and the Alembic migration; otherwise the API
# and worker refuse to start (see src/db/schema_guard.py). Defaults:
#   openai -> 1536   ollama/nomic-embed-text -> 768
# EMBEDDING_DIM=1536

RETRIEVAL_TOP_K=4
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# REQUIRED when EMBEDDING_PROVIDER or LLM_PROVIDER is "openai"; the app fails
# fast at startup if it is missing.
OPENAI_API_KEY=your_openai_api_key_here

# Ollama endpoint (required when a provider is set to "ollama")
OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# Uploads / application
# ---------------------------------------------------------------------------
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=25

# `production` enables the strict posture below (docs off, API key required,
# explicit CORS). Keep `development` for local work.
ENVIRONMENT=development
# Overrides the environment-derived default for OpenAPI/Swagger exposure.
# ENABLE_DOCS=False
METRICS_ENABLED=True

DEBUG=False
LOG_LEVEL=INFO
# Emit single-line JSON logs (set to False for human-readable local output).
LOG_JSON=True
CORS_ORIGINS=*

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# When set, every /api/v1/* route requires this value in the header below.
# MANDATORY in production (the app refuses to start without it).
API_KEY=
API_KEY_HEADER=X-API-Key

# Process-local rate limits (per client IP). For a hard global limit, also use
# `limit_req` at the reverse proxy.
RATE_LIMIT_ENABLED=True
RATE_LIMIT_WINDOW_SECONDS=60
UPLOAD_RATE_LIMIT_REQUESTS=10
CHAT_RATE_LIMIT_REQUESTS=30

# ---------------------------------------------------------------------------
# Streamlit demo UI
# ---------------------------------------------------------------------------
# Internal URL the demo container uses to reach the API (Compose service name;
# only resolvable inside the Docker network).
# DOCMIND_API_URL=http://api:8000/api/v1
# Browser-reachable API origin, used for the sidebar "API docs" link so it opens
# the Swagger UI instead of the non-routable /api/v1 prefix.
# DOCMIND_PUBLIC_API_URL=http://localhost:8000
# Forwarded to the API as the X-API-Key header. Required when the API runs with
# API_KEY set (always in production); leave empty for an unauthenticated dev API.
# DOCMIND_API_KEY=
# Read-only mode for the public demo (docker-compose.demo.yml sets DOCMIND_DEMO_MODE).
# It hides the upload widget, picks the document from the seeded corpus instead and
# caps the question length. Leave off for local development.
# DOCMIND_DEMO_MODE=0
# DOCMIND_DEMO_MAX_QUESTION_CHARS=500
# DOCMIND_DEMO_TOP_K=4

# ---------------------------------------------------------------------------
# Production (docker-compose.prod.yml) — server-side .env, never committed
# ---------------------------------------------------------------------------
# The prod stack REQUIRES the following (Compose aborts when they are missing):
#   POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB
#   REDIS_PASSWORD   enables `requirepass` on the Redis service
#   API_KEY          authentication for every /api/v1/* route
#   EMBEDDING_DIM    must match the model AND the existing migration
#   CORS_ORIGINS     explicit allow-list, e.g. https://app.example.com (never "*")
#   OPENAI_API_KEY   when EMBEDDING_PROVIDER or LLM_PROVIDER is "openai"
#
# Do NOT set DATABASE_URL or REDIS_URL to a localhost URL here: the deploy
# script refuses to run in that case, and the Compose service hosts are `db`
# and `redis`. Options: ENABLE_DOCS (default False), METRICS_ENABLED (default
# True), BACKUP_SYNC_CMD (off-host backup hook, run by the deploy script).
#
# Ollama is opt-in: `docker compose --profile ollama -f docker-compose.prod.yml ...`
# Set EMBEDDING_PROVIDER=ollama / LLM_PROVIDER=ollama and EMBEDDING_DIM=768.
# When no provider is "ollama", the ollama and ollama-init services are not
# started at all.

# ---------------------------------------------------------------------------
# Public demo contour (docker-compose.demo.yml) — server-side .env.demo
# ---------------------------------------------------------------------------
# A separate, isolated stack: its own Compose project (name: docmind-demo), its
# own database, its own credentials and its own public rate limits. Never reuse
# production secrets here — this contour is reachable from the internet.
#
#   mkdir -p /opt/docmind-demo/corpus   # put the demo documents here
#   docker compose -f docker-compose.demo.yml --profile seed run --rm demo-seed
#
# Required (Compose aborts when missing):
#   POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB
#   REDIS_PASSWORD          enables requirepass on the demo Redis
#   API_KEY                 demo-only key; must differ from the production key
#   EMBEDDING_DIM           must match model AND demo migration (openai -> 1536)
#   CORS_ORIGINS            explicit list, e.g. https://demo.example.com
#   DOCMIND_PUBLIC_API_URL  public origin of the demo, e.g. https://demo.example.com
#   OPENAI_API_KEY          when EMBEDDING_PROVIDER or LLM_PROVIDER is openai
#
# Optional (defaults shown):
#   RATE_LIMIT_WINDOW_SECONDS=60
#   CHAT_RATE_LIMIT_REQUESTS=5      per visitor and per worker process
#   UPLOAD_RATE_LIMIT_REQUESTS=10   only the seed run reaches the upload route
#   FORWARDED_ALLOW_IPS=172.16.0.0/12  Docker gateway range, so the per-client
#                                   rate limiter sees the real visitor address
#   SEED_WAIT_SECONDS=180           indexing budget for the demo-seed service
#   DOCMIND_DEMO_MAX_QUESTION_CHARS=500
#   DOCMIND_DEMO_TOP_K=4
#
# Also set a hard spend limit in the provider's account: the in-process limiter
# is per worker and is a speed bump, not a budget cap.
