# EditorConfig: https://editorconfig.org
# Keeps formatting consistent for contributors regardless of editor/OS.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,md,toml}]
indent_size = 2

[Makefile]
indent_style = tab
indent_size = 4

[*.py]
max_line_length = 100

[*.{sh,bash}]
indent_size = 2
